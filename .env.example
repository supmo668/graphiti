# =============================================================================
# Graphiti Stack — Railway Environment Variables Reference
# =============================================================================
# Three services: Neo4j, Graphiti Server (zepai/graphiti), Graphiti MCP Server
#
# Variables are categorized as:
#   [REQUIRED]  — You MUST set these (no default)
#   [PRE-SET]   — Already configured with sensible defaults in config-docker-neo4j.yaml
#   [OPTIONAL]  — Override only if needed
#
# Railway Private Networking:
#   All services communicate via <service-name>.railway.internal
#   This works for HTTP, Bolt (Neo4j), and any TCP traffic.
#   NO TCP proxy is needed for inter-service communication.
# =============================================================================

# ---------------------------------------------------------------------------
# [REQUIRED] API Keys — set as shared variable in Railway project
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# [REQUIRED] Neo4j Service Variables
# Set on the Neo4j service in Railway:
# ---------------------------------------------------------------------------
NEO4J_AUTH=neo4j/your-password-here
# NEO4j uses NEO4J_AUTH format: username/password (set on neo4j service)
#
# Memory limits (required on Railway's 512MB default plan):
# NEO4J_server_memory_heap_initial__size=256m
# NEO4J_server_memory_heap_max__size=512m
# NEO4J_server_memory_pagecache_size=128m

# ---------------------------------------------------------------------------
# [REQUIRED] Graphiti Server (zepai/graphiti) Variables
# Set on the graphiti service in Railway:
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j.railway.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
# OPENAI_API_KEY=${{shared.OPENAI_API_KEY}}    # Railway reference variable syntax
# RAILWAY_RUN_AS_ROOT=true  # Required: zepai/graphiti image has uv at /root/.local/bin

# ---------------------------------------------------------------------------
# [REQUIRED] Graphiti MCP Server Variables
# Set on the graphiti-mcp service in Railway:
# ---------------------------------------------------------------------------
PORT=8000
CONFIG_PATH=config/config-docker-neo4j.yaml
#
# Database provider override via Pydantic env vars (ensures Neo4j is used):
DATABASE__PROVIDER=neo4j
DATABASE__PROVIDERS__NEO4J__URI=bolt://neo4j.railway.internal:7687
DATABASE__PROVIDERS__NEO4J__USERNAME=neo4j
DATABASE__PROVIDERS__NEO4J__PASSWORD=your-password-here
#
# SERVER__PORT=8000  # Alternative: override server port via Pydantic env var

# ---------------------------------------------------------------------------
# [PRE-SET] MCP Server Config (defaults in config-docker-neo4j.yaml / railway.toml)
# Override only if you need non-default behavior
# ---------------------------------------------------------------------------
# SEMAPHORE_LIMIT=10                       # Concurrent episode processing (default: 10)
# GRAPHITI_GROUP_ID=main                   # Graph namespace (default: main)
# USER_ID=mcp_user                         # User identifier (default: mcp_user)
# NEO4J_DATABASE=neo4j                     # Neo4j database name (default: neo4j)
# USE_PARALLEL_RUNTIME=false               # Neo4j parallel runtime — enterprise only

# ---------------------------------------------------------------------------
# [PRE-SET] LLM & Embedder (defaults in config-docker-neo4j.yaml)
# ---------------------------------------------------------------------------
# LLM provider: openai (default), anthropic, gemini, groq, azure_openai
# LLM model: gpt-4o-mini (default)
# Embedder: openai/text-embedding-3-small (default)

# ---------------------------------------------------------------------------
# [OPTIONAL] Alternative LLM Provider Keys
# Only needed if you switch from the default OpenAI provider
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# VOYAGE_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# ---------------------------------------------------------------------------
# [OPTIONAL] External Integrations
# ---------------------------------------------------------------------------
# BRAINTRUST_API_KEY=                      # Braintrust observability integration

# ---------------------------------------------------------------------------
# Local Development (override Railway defaults)
# ---------------------------------------------------------------------------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=demodemo
